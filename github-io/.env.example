VITE_APP_BASE_PATH=/
VITE_FOUNDATION_IMPORT_PATH=cadbuildr.foundation
VITE_FOUNDATION_PACKAGE_NAME=cadbuildr-foundation
VITE_FOUNDATION_VERSION=^0.2.0
VITE_LEGO_IMPORT_PATH=cadbuildr_projects.lego
# Optional: PyPI-style requirement (not used by default; LEGO loads from repo wheel)
# VITE_LEGO_PACKAGE_REQUIREMENT=
# Optional: override wheel URL (default: same-origin local-lego/*.whl — dev serves ../dist via Vite; prod copy wheel into public/local-lego/)
# VITE_LEGO_PACKAGE_WHEEL_URL=
