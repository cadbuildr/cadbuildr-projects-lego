{
  "name": "lego-github-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:lego-wheel": "cd .. && poetry build",
    "sync-lego-wheel": "pnpm run build:lego-wheel && mkdir -p public/local-lego && cp ../dist/cadbuildr_projects_lego-*.whl public/local-lego/",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cadbuildr/cad-kernel-r3f": "^0.1.1",
    "@cadbuildr/cad-pyodide-runtime": "^0.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.169.0",
    "pyodide": "^0.29.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.14"
  }
}
